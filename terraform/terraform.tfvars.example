aws_region = "ap-south-1"

# VPC where the existing ALB lives
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# At least 2 private subnets in different AZs (for RDS Multi-AZ and ECS)
private_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy",
]

# Name portion of the existing internal ALB DNS name
# DNS: internal-<alb_name>-<id>.<region>.elb.amazonaws.com
alb_name = "your-internal-alb-name"

# Hostname the ALB listener rule routes to this service
domain_name = "octo-lens.internal.example.com"

# GitHub App config
github_org    = "your-org"
github_app_id = "123456"

# Set after first ECR push (run `terraform output ecr_push_commands`)
# container_image = "123456789.dkr.ecr.ap-south-1.amazonaws.com/github-pat-monitor:latest"
