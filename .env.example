# ── GitHub App credentials ──────────────────────────────────────────────────
GITHUB_ORG=scapia
GITHUB_APP_ID=3865240
GITHUB_APP_PRIVATE_KEY_PATH=/app/private-key.pem

# ── Dashboard auth (required when binding to 0.0.0.0) ───────────────────────
# Username is always: admin
PAT_MONITOR_PASSWORD=change-me-to-a-strong-password

# ── Postgres (must match docker-compose) ────────────────────────────────────
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password

# ── Slack alerts (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# ── GitHub webhook (optional — enables real-time rescan on PAT events) ───────
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-secret

# ── Policy file path (optional — defaults to --policy flag in compose) ───────
# PAT_MONITOR_POLICY_PATH=/app/policy.yaml
